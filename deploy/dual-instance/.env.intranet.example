# -----------------------------------------------------------------------------
# intranet 容器运行时（无 SSO）
# 复制: cp .env.intranet.example .env.intranet
# 不要写 COMPOSE_* / PORT / DOCS_SECRETS_* / SENTRY_AUTH_TOKEN
# 端口、日志目录在本目录 .env; 容器内日志路径由 compose 固定为 /app/logs
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# 基础配置
# -----------------------------------------------------------------------------
KNOWLEDGE_SITE_URL=http://192.168.10.199:3033
KNOWLEDGE_SITE_NAME=预策·数据连接中心知识库
KNOWLEDGE_SITE_DESCRIPTION=面向内部的预策·数据连接中心知识库：收录 RPA 连接器说明文档、Auth 授权帮助说明和 API 连接器说明文档。提供全文关键词检索、AI语义检索和 RSS 订阅，内置 AI 智能助手和 MCP 服务。

# -----------------------------------------------------------------------------
# GIT 配置
# {branch}: GIT 分支; {path}: 相对 content/docs/ 的路径
# -----------------------------------------------------------------------------
KNOWLEDGE_GIT_REPO_WEB_URL=https://codeup.aliyun.com/yuce-tech/rpa/rpa-products-docs
KNOWLEDGE_GIT_DEFAULT_BRANCH=main
KNOWLEDGE_GIT_BLOB_URL_TEMPLATE=https://codeup.aliyun.com/yuce-tech/rpa/rpa-products-docs/blob/{branch}/content/docs/{path}

# -----------------------------------------------------------------------------
# AI/Agent 配置
# 未配置 LLM_API_KEY 时AI问答不可用, 页脚展示名未设则回退到 LLM_MODEL
# 限流默认QPM 15; 超时默认 18000 毫秒; LRU 缓存默认 64 条;
# -----------------------------------------------------------------------------
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=
LLM_MODEL=
# LLM_MODEL_DISPLAY=DeepSeek V4 Flash
# 当前对接模型是否支持视觉输入。未设或 false 时 AI 对话框不附带图片
# LLM_MODEL_VISION=false
# AI_SEARCH_RATE_LIMIT_PER_MIN=15
# AI_SEARCH_LLM_TIMEOUT_MS=18000
# AI_SEARCH_CACHE_MAX=64

# MCP_SERVER_NAME=rpa-products-docs
# MCP_SERVER_VERSION=1.0.0
# MCP_DISPLAY_NAME=RPA公共知识库
# MCP_INSTRUCTIONS=

# KNOWLEDGE_SKILL_NAME=rpa-products-docs

# -----------------------------------------------------------------------------
# SSO 门禁配置
# 内网关闭 Cube SSO, 不挂 secrets.json
# DOCS_CUBE_SSO_ENABLED=false 时, 页级私有文档只认 DOCS_PRIVATE_ACCESS_TOKEN
# 时间单位为秒: 会话默认 30 天, 7 天后需重新登录, MCP 令牌默认 30 天
# 登录包时间窗默认 180000 毫秒(±3 分钟)
# -----------------------------------------------------------------------------
DOCS_CUBE_SSO_ENABLED=false
DOCS_PRIVATE_ACCESS_TOKEN=
DOCS_SESSION_SECRET=
# DOCS_SESSION_TTL=2592000
# DOCS_SESSION_REAUTH_AFTER=604800
# DOCS_MCP_TOKEN_TTL=2592000
# DOCS_MCP_RESOURCE=
# DOCS_SIGNATURE_WINDOW_MS=180000

# -----------------------------------------------------------------------------
# 资源校验与签名
# 图片鉴权与 User-Agent 门禁未设置时: 生产且 SSO 开启则打开, 开发环境关闭
# 本实例 SSO 关闭, 两项默认关闭
# 门禁拦截 curl、httpx、apifox 等脚本客户端
# 免鉴权前缀相对 content/docs, 逗号分隔, 已包含 _public/_shared
# 配图 ?sign=、分享图 /og/docs/.../quote.png、分享页 HMAC 共用 DOCS_RESOURCE_SIGN_SECRET
# 未设时依次读旧名 DOCS_QUOTE_SIGN_SECRET、会话密钥; 有效期默认与登录包时间窗相同
# 生成: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# -----------------------------------------------------------------------------
# DOCS_RESOURCES_REQUIRE_EMBED_SIGN=true
DOCS_RESOURCE_SIGN_SECRET=
# DOCS_RESOURCE_SIGN_TTL_MS=180000
# DOCS_RESOURCES_PUBLIC_PREFIXES=
# DOCS_USER_AGENT_GATE_ENABLED=true

# -----------------------------------------------------------------------------
# 内容反馈 Webhook 配置
# -----------------------------------------------------------------------------
DOCS_FEEDBACK_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# 审计日志观测配置
# 容器内路径由 compose 固定为 /app/logs, 不要在此设置 DOCS_OBSERVABILITY_LOG_PATH
# -----------------------------------------------------------------------------
DOCS_OBSERVABILITY_LOG_ENABLED=true

# -----------------------------------------------------------------------------
# Sentry 日志
# 未设置 SENTRY_DSN 则整站关闭。DSN、环境与采样在运行时读取, 改完重启即可。
# source map 在构建期上传, 凭证写在本目录 .env, 不要写在这里
# Trace 采样率默认 1; 两类 Profile 采样默认 0(关闭);
# -----------------------------------------------------------------------------
# SENTRY_DSN=
SENTRY_ENVIRONMENT=intranet
# SENTRY_ENABLE_LOGS=true
# SENTRY_SEND_DEFAULT_PII=true
# SENTRY_TRACES_SAMPLE_RATE=1
# SENTRY_PROFILES_SAMPLE_RATE=0
# SENTRY_PROFILE_SESSION_SAMPLE_RATE=0

# -----------------------------------------------------------------------------
# OpenAPI Playground Proxy 配置
# 默认关闭, 浏览器直连 spec.servers。
# 当目标不能由浏览器直连、且 origin 已列入允许名单时开启。
# 页级 :::api-page 不写 proxy 即关闭; 写 proxy: true 才走代理, 并优先于站点开关。
# 允许名单默认含 http://127.0.0.1:8000 与 localhost:8000;
# -----------------------------------------------------------------------------
# DOCS_OPENAPI_PROXY_ENABLED=true
# DOCS_OPENAPI_PROXY_URL=/api/openapi-proxy
# DOCS_OPENAPI_PROXY_ALLOWED_ORIGINS=https://runtime.example.com
