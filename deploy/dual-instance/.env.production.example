# production 容器运行时（知识库 SSO）
# 复制: cp .env.production.example .env.production
# 不要写 COMPOSE_IMAGE / PORT（端口与 secrets 宿主机目录在本目录 .env）

# AI
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=
LLM_MODEL=
# LLM_MODEL_DISPLAY=DeepSeek V4 Flash
# AI_SEARCH_RATE_LIMIT_PER_MIN=15
# AI_SEARCH_LLM_TIMEOUT_MS=18000
# AI_SEARCH_CACHE_MAX=64

# SITE
KNOWLEDGE_SITE_URL=https://knowledge.yuce-tech.cn
KNOWLEDGE_SITE_NAME=预策·数据连接中心知识库
KNOWLEDGE_SITE_DESCRIPTION=面向内部的预策·数据连接中心知识库：收录 RPA 连接器说明文档、Auth 授权帮助说明和 API 连接器说明文档(规划中)。提供全文关键词检索、AI语义检索和 RSS 订阅，内置 AI 智能助手和 MCP 服务。

# GIT
KNOWLEDGE_GIT_REPO_WEB_URL=https://codeup.aliyun.com/yuce-tech/rpa/rpa-products-docs
KNOWLEDGE_GIT_DEFAULT_BRANCH=main
KNOWLEDGE_GIT_BLOB_URL_TEMPLATE=https://codeup.aliyun.com/yuce-tech/rpa/rpa-products-docs/blob/{branch}/content/docs/{path}

# SSO 开启时不要配 legacy token
# DOCS_PRIVATE_ACCESS_TOKEN=

DOCS_CUBE_SSO_ENABLED=true
DOCS_SESSION_SECRET=
# 容器内路径（compose 已写入）；宿主机目录见本目录 .env 的 PRODUCTION_SECRETS_DIR
# 维护: 在仓库根执行 ./scripts/manage-secrets.sh --file /opt/secrets/secrets.json
DOCS_SECRETS_FILE_PATH=/opt/secrets/secrets.json
# DOCS_SESSION_TTL=2592000
# DOCS_SESSION_REAUTH_AFTER=604800
# DOCS_MCP_TOKEN_TTL=2592000
# DOCS_MCP_RESOURCE=
# DOCS_CUBE_ORIGIN_PATTERN=
# DOCS_CUBE_DEFAULT_ORIGIN=https://cube.example.com
# DOCS_RESOURCES_REQUIRE_EMBED_SIGN=true
# DOCS_RESOURCES_PUBLIC_PREFIXES=
# DOCS_USER_AGENT_GATE_ENABLED=true

# MCP / SKILL
# KNOWLEDGE_SKILL_NAME=rpa-products-docs
# MCP_SERVER_NAME=rpa-products-docs
# MCP_SERVER_VERSION=1.0.0
# MCP_DISPLAY_NAME=RPA公共知识库
# MCP_INSTRUCTIONS=

DOCS_FEEDBACK_WEBHOOK_URL=
DOCS_QUOTE_SIGN_SECRET=

DOCS_OBSERVABILITY_LOG_ENABLED=true

# SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# SENTRY_ENABLE_LOGS=true
# SENTRY_SEND_DEFAULT_PII=true
# SENTRY_TRACES_SAMPLE_RATE=1
# SENTRY_PROFILES_SAMPLE_RATE=0
# SENTRY_PROFILE_SESSION_SAMPLE_RATE=0
