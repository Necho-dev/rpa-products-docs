# -----------------------------------------------------------------------------
# Compose 插值与构建参数（本目录 .env）
# 复制: cp .env.example .env
# 改端口或挂载后 docker compose up -d 即可; 换镜像内容才需要 --build
# 容器运行时配置写在 .env.intranet / .env.production, 不要写进本文件
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=yuce-knowledge-docs-dual
COMPOSE_IMAGE=yuce-knowledge-docs:latest

INTRANET_PORT=3033
PRODUCTION_PORT=3031

# 宿主机日志目录（相对本目录; 容器内固定 /app/logs）
INTRANET_LOG_PATH=./logs/intranet
PRODUCTION_LOG_PATH=./logs/production

# 仅 production 挂载; 目录内文件名须为 secrets.json
PRODUCTION_SECRETS_DIR=/opt/secrets

# -----------------------------------------------------------------------------
# Sentry source map（仅构建期）
# 没有 SENTRY_AUTH_TOKEN 则跳过, 构建不失败
# -----------------------------------------------------------------------------
# SENTRY_URL=https://sentry.yuce-tech.cn
# SENTRY_ORG=sentry
# SENTRY_PROJECT=knowledge
# SENTRY_AUTH_TOKEN=
