# AI
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=
LLM_MODEL=
# AI 语义搜索限流策略: 同一用户/IP 每分钟最多触发次数(默认 QPM=15)
# AI_SEARCH_RATE_LIMIT_PER_MIN=15
# AI 语义理解 LLM 调用超时(毫秒, 默认 18000)
# AI_SEARCH_LLM_TIMEOUT_MS=18000
# AI 语义理解 LRU 缓存条目数(默认 64；命中缓存则不调用 LLM、不计入限流)
# AI_SEARCH_CACHE_MAX=64

# SITE
# 生产环境必填; 开发环境 MCP/deeplink 以当前浏览器 Host 为准(localhost / 局域网 IP 均可)
# RSS/OG 等仍可使用此处的 canonical 地址
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_NAME=预策·数据连接中心知识库
NEXT_PUBLIC_SITE_DESCRIPTION=面向内部的预策·数据连接中心知识库：收录 RPA 连接器说明文档、Auth 授权帮助说明和 API 连接器说明文档(规划中)。提供全文关键词检索、AI语义检索和 RSS 订阅，内置 AI 智能助手和 MCP 服务。

# GIT
NEXT_PUBLIC_GIT_REPO_WEB_URL=https://codeup.aliyun.com/yuce-tech/rpa/rpa-products-docs
NEXT_PUBLIC_GIT_DEFAULT_BRANCH=main
NEXT_PUBLIC_GIT_BLOB_URL_TEMPLATE=https://codeup.aliyun.com/yuce-tech/rpa/rpa-products-docs/blob/{branch}/content/docs/{path}

# ACCESS (legacy — 仅 DOCS_CUBE_SSO_ENABLED=false 时用于页级私有文档)
DOCS_PRIVATE_ACCESS_TOKEN=

# CUBE SSO /auth gateway
DOCS_CUBE_SSO_ENABLED=false
DOCS_SESSION_SECRET=
# 本地 / CLI: secrets JSON 文件路径（manage-secrets.sh 读写此文件）
DOCS_SECRETS_FILE_PATH=.secrets/dev-secrets.json
# Docker Compose：宿主机密钥文件目录（挂载至容器 /opt/secrets，目录内文件名须为 secrets.json）
# 生产示例: DOCS_SECRETS_DIR=/opt/secrets 且 DOCS_SECRETS_FILE_PATH=/opt/secrets/secrets.json
# DOCS_SECRETS_DIR=/opt/secrets
# DOCS_SESSION_TTL=2592000
# DOCS_SESSION_REAUTH_AFTER=604800
# DOCS_MCP_TOKEN_TTL=2592000
# DOCS_MCP_RESOURCE=
# DOCS_CUBE_ORIGIN_PATTERN=
# 无 ACCESSORIGIN Cookie 时, 登录引导页 SSO 按钮默认跳转(可选)
# DOCS_CUBE_DEFAULT_ORIGIN=https://cube.example.com
# 嵌入图片: 文档站 /resources/images 鉴权开关
# 未设置时: 生产 + DOCS_CUBE_SSO_ENABLED 默认为 true; 开发默认 false
# 开启后拒绝匿名: 公开前缀 / 嵌入 BFF HMAC / 浏览器 Session
# DOCS_RESOURCES_REQUIRE_EMBED_SIGN=true
# 免鉴权的 content/docs 相对路径前缀(逗号分隔, 慎用; 已内置 _public/_shared)
# DOCS_RESOURCES_PUBLIC_PREFIXES=
# User-Agent 门禁: 拦截 curl/httpx/apifox 等脚本客户端(生产+SSO 默认开启; 开发默认关闭)
# DOCS_USER_AGENT_GATE_ENABLED=true
# 开发环境额外允许的 dev Host（逗号分隔，用于 Next allowedDevOrigins）
# DOCS_ALLOWED_DEV_ORIGINS=192.168.20.17,192.168.20.99

# AGENT SKILL
# NEXT_PUBLIC_SKILL_NAME=rpa-products-docs

# MCP SERVER
# MCP_SERVER_NAME=rpa-products-docs
# MCP_SERVER_VERSION=1.0.0
# MCP_DISPLAY_NAME=RPA公共知识库
# MCP_INSTRUCTIONS=

# 文档反馈(可选): 钉钉 AI 表格自动化 Webhook(「接收到 Webhook 时」触发器地址)
# 未配置时反馈功能不上线(无 UI 入口, API 返回 503)
DOCS_FEEDBACK_WEBHOOK_URL=

# 摘录分享图 HMAC 签名(生产环境必填)
# - /og/docs/.../quote.png 验签依赖此密钥
# - 通过 POST /api/docs/quote-pre-signed 由服务端预签名, 前端不持有签名密钥
# 未设置且 DOCS_CUBE_SSO_ENABLED=false 时不会回退到 DOCS_SESSION_SECRET
# 生成示例: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DOCS_QUOTE_SIGN_SECRET=
# DOCS_SIGNATURE_WINDOW_MS=180000

# 可观测审计日志
# DOCS_OBSERVABILITY_LOG_ENABLED=true
# Docker Compose 默认挂载 ./logs -> 容器 /app/logs; 改宿主机目录时只设此项即可
# DOCS_OBSERVABILITY_LOG_PATH=./logs

# Sentry（Errors / Tracing / Session Replay / Logs / AI / docs.view / mcp.* / sso.* / auth.deny）
# 未设置 SENTRY_DSN 则整站关闭 Sentry。勿提交真实 DSN。
# Docker：须写在项目根 `.env`（Compose build.args 只插值 `.env`，不读 `.env.local`），
# 且改 DSN / ENVIRONMENT 后必须 `docker compose up -d --build`，客户端才会内联生效。
#
# 重要：业务代码必须用静态 `process.env.SENTRY_DSN`（见 src/lib/observability/sentry/env.ts）；
# 动态 `process.env[key]` 会导致浏览器端 DSN 为空，Replay / pageload 永远为空。
# SENTRY_DSN=
# 默认 dev；双实例可用 intranet / production 等区分
# SENTRY_ENVIRONMENT=dev
# Sentry Trace 采样率（默认值 1, 支持按需调低如 0.2）
# SENTRY_TRACES_SAMPLE_RATE=1
# release / git.sha：构建期由 deplpy 注入 git HEAD，勿写入 .env
# 自托管实例与 source map 上传（可选；无 SENTRY_AUTH_TOKEN 时跳过上传）
# SENTRY_URL=https://sentry.yuce-tech.cn
# SENTRY_ORG=sentry
# SENTRY_PROJECT=knowledge
# SENTRY_AUTH_TOKEN=

# PORT(宿主机映射端口, 容器内固定 3000)
PORT=3000
# Docker 实例配置(面向同机部署多个实例场景, 单实例部署可省略)
# COMPOSE_PROJECT_NAME=yuce-knowledge-docs
# COMPOSE_IMAGE=yuce-knowledge-docs:latest
# COMPOSE_CONTAINER_NAME=yuce-knowledge-docs

# LAST MODIFIED SOURCE
# - git: use git log
# - fs: use file mtime
# FUMADOCS_LAST_MODIFIED=fs
