# AI
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=
LLM_MODEL=

# SITE
# 生产环境必填；开发环境 MCP/deeplink 以当前浏览器 Host 为准（localhost / 局域网 IP 均可）
# RSS/OG 等仍可使用此处的 canonical 地址
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_NAME=RPA公共知识库
NEXT_PUBLIC_SITE_DESCRIPTION=RPA制品公共知识库

# GIT
NEXT_PUBLIC_GIT_REPO_WEB_URL=https://codeup.aliyun.com/yuce-tech/rpa/rpa-products-docs
NEXT_PUBLIC_GIT_DEFAULT_BRANCH=main
NEXT_PUBLIC_GIT_BLOB_URL_TEMPLATE=https://codeup.aliyun.com/yuce-tech/rpa/rpa-products-docs/blob/{branch}/content/docs/{path}

# ACCESS (legacy — 仅 DOCS_CUBE_SSO_ENABLED=false 时用于页级私有文档)
DOCS_PRIVATE_ACCESS_TOKEN=

# CUBE SSO /auth gateway
DOCS_CUBE_SSO_ENABLED=false
DOCS_SESSION_SECRET=
DOCS_SECRETS_FILE=.secrets/dev-secrets.json
# Docker Compose: 宿主机 secrets 路径 (挂载到容器 /opt/secrets/secrets.json:ro)
# DOCS_SECRETS_HOST_PATH=/opt/secrets/secrets.json
# DOCS_SESSION_TTL=2592000
# DOCS_SESSION_REAUTH_AFTER=604800
# DOCS_MCP_TOKEN_TTL=2592000
# DOCS_MCP_RESOURCE=
# DOCS_CUBE_ORIGIN_PATTERN=
# 无 ACCESSORIGIN Cookie 时，登录引导页 SSO 按钮默认跳转（可选）
# DOCS_CUBE_DEFAULT_ORIGIN=https://cube.example.com
# 嵌入图片：文档站 /resources/images 须 BFF HMAC
# 未设置时：生产 + DOCS_CUBE_SSO_ENABLED 默认为 true；开发默认 false
# DOCS_RESOURCES_REQUIRE_EMBED_SIGN=true
# 免验签的 content/docs 相对路径前缀（逗号分隔，慎用）
# DOCS_RESOURCES_PUBLIC_PREFIXES=public/images/
# User-Agent 门禁：拦截 curl/httpx/apifox 等脚本客户端（生产+SSO 默认开启；开发默认关闭）
# DOCS_USER_AGENT_GATE_ENABLED=true
# 开发环境额外允许的 dev Host（逗号分隔，用于 Next allowedDevOrigins）
# DOCS_ALLOWED_DEV_ORIGINS=192.168.20.17,192.168.20.99

# AGENT SKILL
# NEXT_PUBLIC_SKILL_NAME=rpa-products-docs

# MCP SERVER
# MCP_SERVER_NAME=rpa-products-docs
# MCP_SERVER_VERSION=1.0.0
# MCP_DISPLAY_NAME=RPA公共知识库
# MCP_INSTRUCTIONS=

# 文档反馈（可选）：钉钉 AI 表格自动化 Webhook（「接收到 Webhook 时」触发器地址）
# 未配置时反馈功能不上线（无 UI 入口，API 返回 503）
DOCS_FEEDBACK_WEBHOOK_URL=

# 摘录分享图 HMAC 签名（生产环境必填，否则 /og/docs/.../quote.png 验签失败返回 404）
# 未设置且 DOCS_CUBE_SSO_ENABLED=false 时不会回退到 DOCS_SESSION_SECRET
# 生成示例: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DOCS_QUOTE_SIGN_SECRET=
# DOCS_SIGNATURE_WINDOW_MS=180000

# PORT
PORT=3000

# LAST MODIFIED SOURCE
# - git: use git log
# - fs: use file mtime
# FUMADOCS_LAST_MODIFIED=fs
